# Copy to .env and fill in. (.env is git-ignored.)
APPLIEDIN_MODE=local

# Local LLM: your Anthropic API key (cloud mode uses Bedrock instead).
ANTHROPIC_API_KEY=

# Local backends
APPLIEDIN_REDIS_URL=redis://localhost:6379/0
APPLIEDIN_LOCAL_DIR=.local

# ── browser-use model (only browser-use uses this; orchestration stays on Haiku) ──
# Set the key for your provider, then set APPLIEDIN_BROWSER_MODEL to match:
#   OpenAI     -> APPLIEDIN_BROWSER_MODEL=gpt-4.1-mini                   (OPENAI_API_KEY)
#   OpenRouter -> APPLIEDIN_BROWSER_MODEL=openrouter/moonshotai/kimi-k2  (OPENROUTER_API_KEY)
#   Anthropic  -> APPLIEDIN_BROWSER_MODEL=claude-sonnet-4-6  (default if unset)
OPENAI_API_KEY=
# OpenRouter (for Kimi and other open models). Get a key at openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
# The model that DRIVES the apply/crawl browser (browser-use). Pick one:
#   APPLIEDIN_BROWSER_MODEL=openrouter/moonshotai/kimi-k2-0905   (needs OpenRouter key)
#   APPLIEDIN_BROWSER_MODEL=claude-sonnet-4-6                    (needs Anthropic key)
#   APPLIEDIN_BROWSER_MODEL=gpt-4.1-mini                         (cheap, needs OpenAI key)
APPLIEDIN_BROWSER_MODEL=claude-sonnet-4-6
# Apply engine: agent (browser-use LLM drives) | scripted (pure Playwright)
APPLIEDIN_APPLY_ENGINE=agent

# Orchestration models — mix & match per component (full LiteLLM strings).
# APPLIEDIN_ORCHESTRATOR_MODEL sets the base for every agent; per-agent overrides
# win over it. Unset everything => the mode default (Haiku). Example split (cheap
# OpenAI base, Haiku where writing quality matters):
# APPLIEDIN_ORCHESTRATOR_MODEL=openai/gpt-4.1-mini
# APPLIEDIN_TAILOR_MODEL=anthropic/claude-haiku-4-5-20251001
# APPLIEDIN_CRITIC_MODEL=anthropic/claude-haiku-4-5-20251001
# APPLIEDIN_SCORER_MODEL=openai/gpt-4.1        # (optional) sharper scoring
# APPLIEDIN_RELEVANCE_MODEL=openai/gpt-4o-mini # (optional) cheaper screening
# APPLIEDIN_WRITER_MODEL=anthropic/claude-sonnet-4-6  # drafts free-text answers

# Optional
APPLIEDIN_DISCOVER_INTERVAL_SEC=21600
APPLIEDIN_WEB_PORT=8787
