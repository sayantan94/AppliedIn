# AppliedIn configuration. Copy to .env and fill in — .env is git-ignored.
#
#   cp .env.example .env
#
# Only ONE line is required to start: OPENAI_API_KEY. Everything else has a
# working default, and most of it can also be changed later from the dashboard.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Your OpenAI key — https://platform.openai.com/api-keys
# Every stage runs openai/gpt-5-mini by default: cheap enough to screen and
# tailor a whole backlog, good enough to write with.
OPENAI_API_KEY=sk-...


# ─────────────────────────────────────────────────────────────────────────────
# HOW MUCH IT APPLIES ON ITS OWN
# ─────────────────────────────────────────────────────────────────────────────

# gated    — tailors everything, applies to NOTHING until you press ▶ Apply.
# auto     — applies by itself to jobs above your score bar, up to the daily cap.
# assisted — stops at tailored; you finish each one in your own browser with the
#            extension. Slower per job, but employers see a real session, which
#            is what avoids the bot challenges that block the other two.
# Changeable any time from the dashboard (Settings → Apply mode).
APPLIEDIN_APPLY_MODE=gated

# In auto mode, only apply to jobs scoring at least this (0–10).
APPLIEDIN_AUTO_MIN_SCORE=8


# ─────────────────────────────────────────────────────────────────────────────
# THE BROWSER
# ─────────────────────────────────────────────────────────────────────────────

# scripted — deterministic Playwright pipeline, no model in the click loop.
#            Fast, cheap, and what you want almost always.
# agent    — hands every form to browser-use (an LLM drives the browser). Slower
#            and pricier, but copes with layouts the scripted path can't read.
#
# You do not have to choose per job: `scripted` ESCALATES BY ITSELF to the agent
# when it cannot find a real form, or when it errors. The one case it will not
# retry is a browser that closed or crashed mid-apply — the form may already have
# been submitted, and a duplicate application is worse than an unconfirmed one,
# so it reports "uncertain" and asks you to check the portal.
APPLIEDIN_APPLY_ENGINE=scripted

# The model used only when the browser needs to SEE the page (vision). A
# stronger model here picks awkward dropdowns more reliably.
APPLIEDIN_BROWSER_MODEL=gpt-5-mini

# false — a real visible Chrome window. Friendlier to bot-detection, and you can
#         watch what it does. Recommended.
# true  — headless. Suits unattended overnight runs, but a security check then
#         has no window to appear in.
APPLIEDIN_BROWSER_HEADLESS=false


# ─────────────────────────────────────────────────────────────────────────────
# MODELS — optional, one variable moves everything
# ─────────────────────────────────────────────────────────────────────────────
#
# Every value is a full LiteLLM string ("openai/…", "anthropic/…",
# "openrouter/…"), so any stage can use any provider — set that provider's key
# below and the stage's variable here.
#
# Unset stages fall back to APPLIEDIN_ORCHESTRATOR_MODEL, which itself falls back
# to openai/gpt-5-mini. So this one line changes the whole pipeline:
# APPLIEDIN_ORCHESTRATOR_MODEL=openai/gpt-5-mini

# Per-stage overrides — each wins over the orchestrator setting.
# APPLIEDIN_RELEVANCE_MODEL=      # first-pass title screen (highest volume, cheapest)
# APPLIEDIN_SCORER_MODEL=         # rates fit 0–10 against your résumé
# APPLIEDIN_TAILOR_MODEL=         # rewords the résumé per posting
# APPLIEDIN_CRITIC_MODEL=         # reviews the tailored résumé
# APPLIEDIN_WRITER_MODEL=         # drafts free-text answers — the usual upgrade,
#                                 # since a human actually reads these
# APPLIEDIN_ORCHESTRATOR_MODEL=   # maps form fields to your approved answers

# Keys for other providers, only needed if you point a stage at one.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# EVERYTHING ELSE — sensible defaults, change if you need to
# ─────────────────────────────────────────────────────────────────────────────

APPLIEDIN_MODE=local                        # local is the only supported mode
APPLIEDIN_REDIS_URL=redis://localhost:6379/0
APPLIEDIN_LOCAL_DIR=.local                  # résumés, screenshots, your facts, saved logins
APPLIEDIN_WEB_PORT=8787                     # dashboard at http://127.0.0.1:<port>
APPLIEDIN_DISCOVER_INTERVAL_SEC=21600       # how often to look for new postings (6h)

# How many jobs are scored + tailored at once. Tailoring waits on the network,
# not the CPU, so a few at a time is much faster than one.
# APPLIEDIN_EVAL_LANES=4

# Set to "off" to stop discovery entirely and only process what you queue by hand.
# APPLIEDIN_DISCOVERY=on

# browser-use sends anonymised usage telemetry by default. This product runs on
# your machine, so it is turned OFF unless you opt back in here.
# ANONYMIZED_TELEMETRY=true
