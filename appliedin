#!/usr/bin/env bash
# appliedin — the one entry point.
#
#   ./appliedin setup     install everything (uv, Python, deps, Redis, Tectonic)
#   ./appliedin start     start the daemon in the background (dashboard + workers)
#   ./appliedin stop      stop it
#   ./appliedin status    is it up? plus the pipeline board
#   ./appliedin logs      tail the daemon log (Ctrl-C to stop)
#   ./appliedin discover | work | run | resume <pk> "<answer>"
#
# `start` installs anything missing, brings up Redis and checks the config before
# launching. There used to be a second script for that, which meant one path
# fixed your environment and the other detached and failed quietly in the
# background. One entry point cannot disagree with itself.
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$HOME/.local/bin:$PATH"
export APPLIEDIN_MODE="${APPLIEDIN_MODE:-local}"

say()  { printf "\033[1;32m▸\033[0m %s\n" "$1"; }
warn() { printf "\033[1;33m⚠\033[0m  %s\n" "$1"; }

# --- install, on demand or when dependencies moved ----------------------------
ensure_env() {
  local stamp; stamp="$(cat pyproject.toml uv.lock 2>/dev/null | shasum | cut -d' ' -f1)"
  if [ ! -f .venv/.appliedin-env ] || [ "$(cat .venv/.appliedin-env 2>/dev/null || true)" != "$stamp" ]; then
    say "first run or dependencies changed — running setup"
    ./setup.sh
  fi
}

# --- checks that run before the daemon is launched ----------------------------
preflight() {
  # Redis holds the queues and the runtime flags. Nothing works without it.
  redis-cli ping >/dev/null 2>&1 || {
    command -v redis-server >/dev/null 2>&1 || { warn "redis missing — run ./appliedin setup"; exit 1; }
    redis-server --daemonize yes >/dev/null && say "started redis"
  }

  [ -f .env ] || { warn "no .env — run ./appliedin setup"; exit 1; }
  # Orchestration (discovery, scoring, tailoring, the writer) runs on OpenAI, so
  # this is the key that actually gates startup. Applying uses the Claude Code
  # CLI's own subscription session, never an API key.
  grep -q '^OPENAI_API_KEY=.\+' .env || {
    warn "paste your key into .env (OPENAI_API_KEY=...) and try again"; exit 1; }

  # Warnings, not blockers: everything up to the apply works without these.
  [ -f resume/base.tex ] || warn "no resume/base.tex — tailoring needs it"
  command -v claude >/dev/null 2>&1 || \
    warn "no 'claude' on PATH — discovery and tailoring run, but applying needs the Claude Code CLI"
}

case "${1:-}" in
  setup) exec ./setup.sh ;;
  start) ensure_env; preflight ;;
esac

exec uv run python -m cli "$@"
