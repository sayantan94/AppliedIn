[Unit]
Description=AppliedIn local daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
ExecStart=@PYTHON@ -m daemon
Environment=APPLIEDIN_MODE=local
Environment=APPLIEDIN_USER_SERVICE=1
KillMode=process
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
